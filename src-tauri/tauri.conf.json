{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Welcome",
  "version": "0.1.0",
  "identifier": "io.github.josei.welcome",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Welcome",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
